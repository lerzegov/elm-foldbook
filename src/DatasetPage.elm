-- used in elm-foldbook, without logo and title 


viewSheet : Result Error Env -> Model -> Element Msg
viewSheet curEnv model =
    let

        lenSpreadsheetWidth =
            Array.foldl
                (\x y -> x + y)
                0
                ( Array.append model.spreadsheetUIModel.rowHeaderWidths model.spreadsheetUIModel.colWidths)
            |> (+) model.spreadsheetUIModel.topRightHeaderWidth


        spreadsheetView =
            SpreadsheetUI.viewSpreadsheetUI model.spreadsheetUIModel
    in
    column [ ]
        -- messi 600px larghezza sheet si adatta se superiore no se inferiore
        [ -- title and dim trays
          column [ width fill ]
            -- styles of trays set in DnDTray group styles
            -- spreadsheet in pivot table
            [  -- AppUtil.myLog ("pagetray" ++ Debug.toString model.spreadsheetUIModel.curDatasetView.pageTray)
                --if model.spreadsheetUIModel.curDatasetView.pageTray /= [] then
              Element.map SpreadsheetUIMsg 
                <| SpreadsheetUI.viewPivotReshaper 
                    model.spreadsheetUIModel 
                    lenSpreadsheetWidth 
                    model.showPivotReshaper--(lenSpreadsheetWidth |> toFloat |> (*) 0.5 >> round)
            , row 
                [ width (px lenSpreadsheetWidth), height shrink 
                --, below (viewPivotReshaper model lenSpreadsheetWidth) -- NO, overlaps
                ]
                [ Element.map SpreadsheetUIMsg spreadsheetView ]
            , column [ width (px lenSpreadsheetWidth), height shrink ]
                [ row [ spacing 10, width fill ]
                    [ buttonToggleFormulaEditor model 40
                    --, buttonRecalculate model 40
                    , buttonUpdateFormulas model 40
                    --Element.map CalcMsg <| CalcEngine.viewCommands
                    --, buttonGroupFormulaPivot
                    ]
                , viewFormulaEditor model lenSpreadsheetWidth

                -- logging calculation messages, activated via mode.showLogs in Main.init
                , viewLogs model
                ]
            ]
        ]



viewFormulaEditor : Model -> Int -> Element Msg
viewFormulaEditor model spreadsheetWidth =
    let
        editorElement editorId input =
            case editorId of
                Just editorIdJust ->
                    Element.html <|
                        Html.node "code-mirror-formula-editor"
                            [ HtmlAttr.attribute "data-initial-value" input
                            , HtmlAttr.attribute "id" editorIdJust
                            , Html.Events.on "formulaContentChanged" 
                                (Decode.map FormulaContentChanged 
                                    (Decode.at [ "detail" ] 
                                        (Decode.map2 (\editorIdArg contentArg -> 
                                            { editorId = editorIdArg, content = contentArg }) 
                                            (Decode.field "editorId" Decode.string) (Decode.field "content" Decode.string))))
                            ]
                            []

                Nothing ->
                    Element.none
    in
    if model.showFormulaEditor then
        column [ padding 20, spacing 10, width (px (max 1200 spreadsheetWidth))]
            [ row ([ UiFont.size 24, UiFont.bold, width fill ] ++ noWrapAttributes) [ text "Formula Editor" ]
            , el [ UiFont.size 16, width fill ] (editorElement (Just model.editorId) model.calcModel.formulaInput)
            ]

    else
        Element.none

-- USED FOR STANDALONE SHEETS, IN MARKUP FOLDBOOK USES viewSheet
view : Navigation.Key -> Result Error Env -> Model -> Element Msg
view key curEnv model =
    let

        lenSpreadsheetWidth =
            1200

        -- 600px
        curXModel =
            curEnv |> CalcEngine.getXModelFromEnv |> Maybe.withDefault XModel.emptyXModel

        spreadsheetView =
            SpreadsheetUI.viewSpreadsheetUI model.spreadsheetUIModel

        datasetNames =
            curXModel.datasetRefs
    in
    column [  ]
        -- messi 600px larghezza sheet si adatta se superiore no se inferiore
        [ -- title and dim trays
          column []
            -- styles of trays set in DnDTray group styles
            [ row [ width fill, spacing 6 ] [ logo, viewTitle curXModel.modelRef ]
            , viewDatasetNavTabs key datasetNames model.spreadsheetUIModel.curDataset.ref

            --, (viewNavMenu datasetNames)
            ]

        -- spreadsheet in pivot table
        , row [ width (px lenSpreadsheetWidth), height shrink ]
            [ Element.map SpreadsheetUIMsg spreadsheetView ]
        , column [ width (px lenSpreadsheetWidth), height shrink ]
            [ row [ spacing 10 ]
                [ Element.map CalcMsg <| CalcEngine.viewCommands
                , buttonGroupFormulaPivot
                ]
            , Element.map SpreadsheetUIMsg 
                <| SpreadsheetUI.viewPivotReshaper model.spreadsheetUIModel 
                    (lenSpreadsheetWidth |> toFloat |> (*) 0.5 >> round)
                    model.showPivotReshaper
            , viewFormulaEditor model lenSpreadsheetWidth

            -- logging calculation messages, activated via mode.showLogs in Main.init
            , viewLogs model
            ]
        ]
