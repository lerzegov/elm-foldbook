type alias Model =
    { spreadsheetUIModel : SpreadsheetUI.Model
    , calcModel : CalcEngine.Model
    , autoRecalc : Bool
    , hints : List String
    , editorId : String
    , showFormulaEditor : Bool
    , editor : Editor
    , showPivotReshaper : Bool
    , showLogs : Bool
    }


initialModel : Result Error Env -> DatasetRef -> Model
initialModel env datasetRef =
    let
        initialShowFormulaEditor =
            False

        initialShowPivotReshaper =
            True

        initialShowLogs =
            True

        initialCalcModel =
            CalcEngine.initialModel env datasetRef

        initialXModel =
            CalcEngine.getXModelFromEnv env |> Maybe.withDefault XModel.emptyXModel

        initialSpreadsheetUIModel =
            SpreadsheetUI.initialModel initialXModel datasetRef


        initialEditorId =
            "editor-" ++ datasetRef
        initialEditor =
            { id = initialEditorId, editorType = "formula", initialized = False }
    in
    { spreadsheetUIModel = initialSpreadsheetUIModel
    , calcModel = initialCalcModel
    , autoRecalc = False
    , hints = []
    , editorId = initialEditorId
    , editor = initialEditor
    , showFormulaEditor = initialShowFormulaEditor
    , showPivotReshaper = initialShowPivotReshaper
    , showLogs = initialShowLogs
    }


type Msg
    = SpreadsheetUIMsg SpreadsheetUI.Msg
    | CalcMsg CalcEngine.Msg -- formerly UI.Msg
      -- | Initialize
    | ReceiveHints { editorId : String, hints : List String } -- Include editorId
    | FormulaContentChanged { editorId : String, content : String }
    | RequestHints { editorId : String, word : String }
    | InitEditor
    | OpenDataset Navigation.Key String
    | TriggerPageReload
    | ToggleFormulaEditor
    | TogglePivotReshaper


type alias Models =
    { calc : CalcEngine.Model, x : XModel, ui : SpreadsheetUI.Model }



-- Update-
-- no need to add xModel to update args in Main, it is already in model here
-- in component must add xModel to update in order to send/receive xModel to/from Main


update : Msg -> Result Error Env -> Model -> ( Model, Result Error Env, Cmd Msg )
update msg prevEnv model =
    case myLog "SpreadsheetUIMsg in DatasetPage" msg of
        SpreadsheetUIMsg subMsg ->
            case subMsg of
                DnDTrayMsg trayMsg ->
                    let
                        ( sUiModel, xModel, dndMsg ) =
                            SpreadsheetUI.update 
                                subMsg 
                                model.spreadsheetUIModel 
                                (getXModelFromEnv prevEnv |> Maybe.withDefault XModel.emptyXModel)
                    in
                    ( { model | spreadsheetUIModel = sUiModel }
                    , setXModelToEnv prevEnv xModel
                    , Cmd.map SpreadsheetUIMsg dndMsg
                    )
                _ -> -- other msgs alreadt handled in DatasetPage.update previous version
                    
                    let
                        curCalcModel = model.calcModel
                        curEnv = prevEnv
                        curXModel = getCurXModelFromEnv curEnv

                        -- Update the spreadsheetUIModel and xModel from the subMsg action in SpreadsheetUI
                        (sUiModel1, xModel1, sUiCmd1) =
                            SpreadsheetUI.update subMsg model.spreadsheetUIModel curXModel

                        -- Function to handle recalculation if needed
                        handleRecalc : List DatasetRef -> CalcEngine.Model -> XModel -> SpreadsheetUI.Model -> (Models, List (Cmd Msg))
                        handleRecalc datasetRefs calcModel xModel sUiModel =
                            case List.filter (\r -> r == calcModel.datasetRef) datasetRefs |> List.head of
                                Just datasetName ->
                                    let
                                        envWithChangedXModel = CalcEngine.setXModelToEnv curEnv xModel
                                        (calcModelCalculated, envCalculated, calcCmd) =
                                            CalcEngine.update CalcEngine.EvalFormulas calcModel envWithChangedXModel
                                        xModelCalculated = CalcEngine.getXModelFromEnv envCalculated |> Maybe.withDefault XModel.emptyXModel
                                        (sUiModelRefresh, xModelRefresh, sUiCmdRefresh) =
                                            SpreadsheetUI.update SpreadsheetUI.RefreshFromXModel sUiModel xModelCalculated
                                        curCalcCmds = [Cmd.map CalcMsg calcCmd, Cmd.map SpreadsheetUIMsg sUiCmdRefresh]
                                        curModels = { calc = calcModelCalculated, x = xModelRefresh, ui = sUiModelRefresh }
                                    in
                                    (curModels, curCalcCmds)

                                Nothing ->
                                    ({ calc = calcModel, x = xModel, ui = sUiModel }, [Cmd.none])

                        (models, recalcCmds) = handleRecalc xModel1.datasetsToRecalc curCalcModel xModel1 sUiModel1
                        curDndModel = models.ui.dndTrayModel
                        updatedTrayData = models.ui.sheetUIData.trayData
                        spreadsheetUIModelPreDnD = models.ui
                        updatedSpreadsheetUIModel = { spreadsheetUIModelPreDnD | dndTrayModel = { curDndModel | trayData = updatedTrayData } }

                        finalModel = { model | spreadsheetUIModel = updatedSpreadsheetUIModel, calcModel = models.calc }
                        finalEnv = CalcEngine.setXModelToEnv curEnv models.x
                        finalCmds = [Cmd.map SpreadsheetUIMsg sUiCmd1] ++ recalcCmds
                    in
                    (finalModel, finalEnv, Cmd.batch finalCmds)
        -- SpreadsheetUIMsg subMsg ->
        --     let
        --         curCalcModel =
        --             model.calcModel

        --         curEnv =
        --             prevEnv

        --         curXModel =
        --             getCurXModelFromEnv curEnv

        --         -- Update the spreadsheetUIModel and xModel from the subMsg action in SpreadsheetUI
        --         ( sUiModel1, xModel1, sUiCmd1 ) =
        --             SpreadsheetUI.update subMsg model.spreadsheetUIModel curXModel

        --         -- Function to handle recalculation if needed
        --         --  RECALC TRIGGERING MOVED TO MAIN EnvUpdated but still needed here, TODO: check if needed
        --         handleRecalc : List DatasetRef -> CalcEngine.Model -> XModel -> SpreadsheetUI.Model -> ( Models, List (Cmd Msg) )
        --         handleRecalc datasetRefs calcModel xModel sUiModel =
        --             case List.filter (\r -> r == calcModel.datasetRef) datasetRefs |> List.head of
        --                 Just datasetName ->
        --                     -- calcModel.datasetRef is in datasetsToRecalc
        --                     let
        --                         -- SaveCell populates datasetsToRecalc
        --                         envWithChangedXModel =
        --                             CalcEngine.setXModelToEnv curEnv xModel

        --                         -- trigger recalculation, disabled, moved to EnvUpdated
        --                         ( calcModelCalculated, envCalculated, calcCmd ) =
        --                             CalcEngine.update CalcEngine.EvalFormulas calcModel envWithChangedXModel

        --                         xModelCalculated =
        --                             CalcEngine.getXModelFromEnv envCalculated |> Maybe.withDefault XModel.emptyXModel

        --                         -- Step 2: Update SpreadsheetUI with updated XModel
        --                         ( sUiModelRefresh, xModelRefresh, sUiCmdRefresh ) =
        --                             SpreadsheetUI.update
        --                                 SpreadsheetUI.RefreshFromXModel
        --                                 sUiModel
        --                                 xModelCalculated

        --                         curCalcCmds =
        --                             [ Cmd.map CalcMsg calcCmd, Cmd.map SpreadsheetUIMsg sUiCmdRefresh ]

        --                         curModels =
        --                             { calc = calcModelCalculated, x = xModelRefresh, ui = sUiModelRefresh }
        --                     in
        --                     ( curModels, curCalcCmds )

        --                 Nothing ->
        --                     -- No recalculation needed, return the same models and no command
        --                     ( { calc = calcModel, x = xModel, ui = sUiModel }, [ Cmd.none ] )

        --         -- end of handleRecalc
        --         ( models, recalcCmds ) =
        --             handleRecalc xModel1.datasetsToRecalc curCalcModel xModel1 sUiModel1
        --         curDndModel =
        --             model.spreadsheetUIModel.dndTrayModel
        --         updatedTrayData =
        --             models.ui.sheetUIData.trayData
        --         spreadsheetUIModelPreDnD =
        --             models.ui 
        --         updatedSpreadsheetUIModel =
        --             { spreadsheetUIModelPreDnD 
        --                 | dndTrayModel = { curDndModel | trayData = updatedTrayData }
        --             }

        --         --({calc=curCalcModel, x=xModel1, ui=sUiModel1}, [Cmd.none])  -- no recalc
        --         finalModel =
        --             { model
        --                 | spreadsheetUIModel =  updatedSpreadsheetUIModel
        --                 , calcModel = models.calc
        --             }

        --         finalEnv =
        --             CalcEngine.setXModelToEnv curEnv models.x

        --         finalCmds =
        --             [ Cmd.map SpreadsheetUIMsg sUiCmd1 ] ++ recalcCmds
        --     in
        --     -- Debug.log ("NewHeaderTree: " ++ Debug.toString models.ui.sheetUIData)
        --     ( finalModel, finalEnv, Cmd.batch finalCmds )

        -- con Cmd.none non funziona il drag and drop
        CalcMsg calcMsg ->
            let
                ( updatedCalcModel, newEnv, calcCmd ) =
                    CalcEngine.update calcMsg model.calcModel prevEnv

                curDatasetName =
                    model.spreadsheetUIModel.curDataset.ref

                updatedXModel =
                    CalcEngine.getXModelFromEnv newEnv |> Maybe.withDefault XModel.emptyXModel

                curDataset =
                    XModel.getDatasetByRef curDatasetName updatedXModel.datasets |> Maybe.withDefault XModel.emptyDataset

                updatedSpreadsheetUIModel =
                    SpreadsheetUI.updateSpreadsheetFromXModel model.spreadsheetUIModel updatedXModel curDataset
            in
            -- Debug.log ("updatedDataset.data" ++ Debug.toString curDataset)
            ( -- add updateSpreadsheetUIModel
              { model
                | spreadsheetUIModel = updatedSpreadsheetUIModel
                , calcModel = updatedCalcModel
              }
            , newEnv
            , Cmd.map CalcMsg calcCmd
            )

        FormulaContentChanged { editorId , content } ->
            if editorId == model.editorId then
                    let
                        prevCalcModel =
                            model.calcModel

                        updatedCalcModel =
                            { prevCalcModel | formulaInput = content }
                    in
                    ( { model | calcModel = updatedCalcModel }
                    , prevEnv
                    , Cmd.none
                    )
            else
                ( model, prevEnv, Cmd.none )

        RequestHints { editorId, word } ->
            let
                curXModel =
                    getCurXModelFromEnv prevEnv

                hints =
                    getHints curXModel model.calcModel.datasetRef word

                editorIdElm =
                    model.editorId
            in
            if editorId == editorIdElm then
                ( model, prevEnv, sendHintsToJs editorId hints )

            else
                ( model
                , prevEnv
                  -- , sendHintsToJs editorIdElm ["mismatched editorIds: js=" ++ editorId ++ " and elm=" ++ editorIdElm]
                , Cmd.none
                )

        ReceiveHints { editorId, hints } ->
            if editorId == model.editorId then
                ( { model | hints = hints }, prevEnv, Cmd.none )

            else
                ( model, prevEnv, Cmd.none )

        InitEditor ->
            -- editor init moved to init as direct port call
            ( model, prevEnv, Cmd.none )

        OpenDataset key datasetName ->
            ( model
            , prevEnv
            , Cmd.batch [ navigateToDataset key datasetName, cmdMsg TriggerPageReload ]
            )

        TriggerPageReload ->
            --( model, prevEnv, Ports.reloadPage () )
            ( model, prevEnv, Cmd.none )

        ToggleFormulaEditor ->
            let
                newShowFormulaEditor = not model.showFormulaEditor
                curEditor = model.editor
                cmd =
                    if newShowFormulaEditor && not model.editor.initialized then
                        Ports.initializeEditor model.editor.id
                    else if not newShowFormulaEditor && model.editor.initialized then
                        Ports.disposeEditor model.editor.id
                    else
                        Cmd.none
                newEditor =
                    { curEditor | initialized = newShowFormulaEditor }
            in
            ( { model | showFormulaEditor = newShowFormulaEditor, editor = newEditor }
            , prevEnv
            , cmd )


        TogglePivotReshaper ->
            ( { model | showPivotReshaper = not model.showPivotReshaper }, prevEnv, Cmd.none )


sendHintsToJs : String -> List { label : String } -> Cmd Msg
sendHintsToJs editorId hints =
    let
        payload =
            { editorId = editorId, hints = hints }
    in
    -- Debug.log ("sendHintsToJs payload" ++ Debug.toString payload)
    Ports.receiveHints payload


getHints : XModel -> DatasetRef -> String -> List { label : String }
getHints xModel datasetRef word =
    XModel.promptCoordsForPartialRangeName xModel datasetRef word


getCurXModelFromEnv : Result Error Env -> XModel
getCurXModelFromEnv env =
    env |> CalcEngine.getXModelFromEnv |> Maybe.withDefault XModel.emptyXModel



